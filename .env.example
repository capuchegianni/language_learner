# API key for your chosen AI provider. This is the only AI-related env variable.
# The model and base URL are configured at runtime from the Settings page in the UI.
# Leave empty if using a local provider like Ollama (no key required).
API_KEY=

# Backend Database URL
DATABASE_URL="file:./data/dev.db"

# Backend port
PORT=

# API URL for frontend
VITE_BACKEND_URL=

# Frontend URL (used for CORS and OAuth redirects)
FRONTEND_URL=

# Cloudflare tunnel token for linking prod backend to frontend
CLOUDFLARE_TUNNEL_TOKEN=

# Google OAuth Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Session secret (generate a random string for production)
SESSION_SECRET=

# Node environment
NODE_ENV=
