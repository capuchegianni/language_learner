# Backend Database URL
DATABASE_URL="file:./data/dev.db"

# Backend port
PORT=

# API URL for frontend
VITE_BACKEND_URL=

# Frontend URL (used for CORS and OAuth redirects)
FRONTEND_URL=

# Cloudflare tunnel token for linking prod backend to frontend
CLOUDFLARE_TUNNEL_TOKEN=

# Google OAuth Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Session secret (generate a random string for production)
SESSION_SECRET=

# Node environment
NODE_ENV=

# Free AI usage (Gemini API key for Free tier)
GEMINI_API_KEY=

# Premium AI usage (Gemini API key for Premium tier)
GEMINI_PREMIUM_API_KEY=

# Admin user emails (comma-separated, e.g. "admin@example.com,owner@domain.com")
ADMIN_EMAILS=
