datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Plan {
  FREE
  PREMIUM
}

enum LessonStatus {
  GENERATED
  SUBMITTED
  GRADED
}

enum ActionType {
  RULE_PROPOSAL
  LESSON_GENERATION
  LESSON_CORRECTION
}

model User {
  id          String   @id @default(uuid())
  googleId    String   @unique
  displayName String
  email       String   @unique
  avatarUrl   String?
  plan        Plan     @default(FREE)
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  words           Word[]
  rules           Rule[]
  lessons         Lesson[]
  settings        Setting[]
  lessonProposals LessonProposal[]
}

model Word {
  id             String   @id @default(uuid())
  targetLanguage String
  nativeLanguage String
  pronunciation  String?
  partOfSpeech   String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessons LessonWord[]

  @@unique([userId, targetLanguage])
  @@index([userId])
}

model Rule {
  id          String   @id @default(uuid())
  title       String
  explanation String
  examples    String // Stored as JSON string
  exceptions  String? // Stored as JSON string or text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  @@unique([userId, title])
  @@index([userId])
}

model Lesson {
  id                 String       @id @default(uuid())
  title              String?
  date               DateTime     @default(now())
  ruleId             String?
  rule               Rule?        @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  isReview           Boolean      @default(false)
  wordsCount         Int          @default(5)

  status             LessonStatus @default(GENERATED)
  submissionImage    String?
  rawPrompt          String?

  overallScore       Int?
  generalFeedback    String?
  handwrittenOcrText String?

  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  words              LessonWord[]
  exercises          LessonExercise[]

  @@index([ruleId])
  @@index([userId])
}

model LessonExercise {
  id             String   @id @default(uuid())
  lessonId       String
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  exerciseNumber Int

  instruction    String
  content        Json     // Structured definition: targetWords, sentences, conjugation matrix, etc.

  userSubmission Json?    // Polymorphic submission data: UserSubmission

  score          Int?
  feedback       String?
  corrections    Json?    // Array of correction strings: string[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([lessonId, exerciseNumber])
  @@index([lessonId])
}

model LessonWord {
  lessonId String
  wordId   String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  word     Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([lessonId, wordId])
  @@index([wordId])
  @@index([lessonId])
}

model Setting {
  id        String   @id @default(uuid())
  key       String
  value     String
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model LessonProposal {
  id             String   @id @default(uuid())
  title          String
  explanation    String
  category       String?
  difficulty     String?
  isReview       Boolean  @default(false)
  targetLanguage String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UsageRecord {
  id         String     @id @default(uuid())
  userHash   String
  actionType ActionType
  date       String     // UTC date string "YYYY-MM-DD"
  count      Int        @default(0)

  @@unique([userHash, actionType, date])
  @@index([userHash])
}
